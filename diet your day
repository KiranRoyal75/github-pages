// diet-your-day (Full Stack App)

// Backend - Express.js API (server.js)
const express = require("express");
const mongoose = require("mongoose");
const cors = require("cors");
const app = express();
const PORT = 5000;

app.use(express.json());
app.use(cors());

mongoose.connect("mongodb://localhost:27017/dietYourDay", {
  useNewUrlParser: true,
  useUnifiedTopology: true,
});

const UserSchema = new mongoose.Schema({
  weight: Number,
  height: Number,
  bmi: Number,
  category: String,
  nationality: String,
  dietType: String,
  allergies: String,
  ingredients: String,
  stars: { type: Number, default: 0 },
});

const User = mongoose.model("User", UserSchema);

app.post("/save", async (req, res) => {
  const user = new User(req.body);
  await user.save();
  res.send({ message: "Data saved successfully!" });
});

app.listen(PORT, () => console.log(`Server running on port ${PORT}`));

// Frontend - React.js (App.js)
import { useState } from "react";
import axios from "axios";

function App() {
  const [weight, setWeight] = useState("");
  const [height, setHeight] = useState("");
  const [bmi, setBmi] = useState(null);
  const [category, setCategory] = useState("");
  const [nationality, setNationality] = useState("");
  const [dietType, setDietType] = useState("");
  const [allergies, setAllergies] = useState("");
  const [ingredients, setIngredients] = useState("");
  const [stars, setStars] = useState(0);

  const calculateBmi = () => {
    if (weight && height) {
      const bmiValue = (weight / (height * height)).toFixed(2);
      setBmi(bmiValue);
      setCategory(bmiValue < 18.5 ? "Underweight" : bmiValue < 24.9 ? "Healthy" : "Overweight");
    }
  };

  const saveData = async () => {
    await axios.post("http://localhost:5000/save", { weight, height, bmi, category, nationality, dietType, allergies, ingredients, stars });
    alert("Data saved successfully!");
  };

  return (
    <div>
      <h1>Diet Your Day</h1>
      <input type="number" placeholder="Weight (kg)" onChange={(e) => setWeight(e.target.value)} />
      <input type="number" placeholder="Height (m)" onChange={(e) => setHeight(e.target.value)} />
      <button onClick={calculateBmi}>Calculate BMI</button>
      {bmi && <p>Your BMI: {bmi} ({category})</p>}

      <select onChange={(e) => setNationality(e.target.value)}>
        <option value="Indian">Indian</option>
        <option value="American">American</option>
        <option value="Chinese">Chinese</option>
      </select>
      <select onChange={(e) => setDietType(e.target.value)}>
        <option value="Vegetarian">Vegetarian</option>
        <option value="Non-Vegetarian">Non-Vegetarian</option>
        <option value="Vegan">Vegan</option>
      </select>
      <textarea placeholder="Allergies" onChange={(e) => setAllergies(e.target.value)}></textarea>
      <textarea placeholder="Available Ingredients" onChange={(e) => setIngredients(e.target.value)}></textarea>
      <button onClick={saveData}>Save Data</button>
    </div>
  );
}

export default App;
